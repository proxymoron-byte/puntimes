---
import Base from '../layouts/Base.astro';
import { allEntries, entryPath, url } from '../lib/site';
const list = await allEntries();
const years = [...new Set(list.map((e) => e.data.date.getUTCFullYear()))];
const md = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', timeZone: 'UTC' });
---
<Base active="Archive" title="Archive">
  <div class="page-head"><div class="eyebrow">{list.length} entries</div><h1>Archive</h1></div>
  {years.map((y) => (
    <section class="yr paper">
      <h2>{y}</h2>
      <ul>{list.filter((e) => e.data.date.getUTCFullYear() === y).map((e) => (
        <li><time>{md(e.data.date)}</time><a href={url(entryPath(e))}>{e.data.title}</a>{e.data.images.length > 0 && <span>comic</span>}</li>
      ))}</ul>
    </section>
  ))}
</Base>
<style>
.yr{padding:24px 24px 14px;border-radius:3px;margin-bottom:34px}
.yr:nth-of-type(odd){transform:rotate(-.5deg)}
.yr h2{font-family:var(--hand);font-size:40px;font-weight:400;line-height:1;margin-bottom:6px}
ul{list-style:none;margin:0;padding:0}
li{display:flex;gap:14px;align-items:baseline;padding:9px 0;border-bottom:1px dashed #CDBFAF}
li:last-child{border-bottom:0}
time,span{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-variant-numeric:tabular-nums}
time{min-width:58px}
a{color:var(--ink);text-decoration:none;font-weight:600}a:hover{color:var(--cobalt)}
</style>
