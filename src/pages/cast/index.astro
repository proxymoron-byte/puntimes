---
import Base from '../../layouts/Base.astro';
import { allEntries, cast, speakersOf, url } from '../../lib/site';
const list = await allEntries();
const count = (id: string) => list.filter((e) => speakersOf(e).includes(id)).length;
---
<Base active="Cast" title="Cast">
  <div class="page-head"><h1>The cast</h1><p>Everyone who's been caught punning.</p></div>
  <ul class="people">
    {cast.map((p) => (
      <li class="paper"><a href={url(`cast/${p.id}/`)}><i class="chip" style={`background-color:var(--c-${p.id})`}></i><b>{p.name.toLowerCase()}</b><span>{count(p.id)} entries</span></a></li>
    ))}
  </ul>
</Base>
<style>
.people{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:22px}
.people li{padding:14px 14px 16px;border-radius:3px}
.people li:nth-child(odd){transform:rotate(-1.5deg)}.people li:nth-child(even){transform:rotate(1.2deg)}
.people a{display:flex;flex-direction:column;color:var(--ink);text-decoration:none}
.chip{display:block;height:90px;border-radius:2px;background-image:var(--grain);background-blend-mode:soft-light}
.people b{font-family:var(--hand);font-size:32px;font-weight:400;line-height:1;margin-top:10px}
.people span{font-size:13px;color:var(--muted)}
</style>
