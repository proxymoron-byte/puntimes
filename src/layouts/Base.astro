---
import { cast, site, url } from '../lib/site';
interface Props { title?: string; description?: string; active?: string }
const { title, description = site.tagline, active = '' } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const castVars = cast.map((p) => `--c-${p.id}:${p.color};--i-${p.id}:${p.ink};`).join('');
const castDark = cast.map((p) => `--c-${p.id}:${p.colorDark || p.color};`).join('');
const nav = [['', 'Feed'], ['comics/', 'Comics'], ['cast/', 'Cast'], ['archive/', 'Archive']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {site.unlisted && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500&family=Gochi+Hand&display=swap" />
  <style set:html={`:root{${castVars}}@media (prefers-color-scheme:dark){:root{${castDark}}}`}></style>
</head>
<body>
  <div class="shell">
    <aside class="side">
      <a class="logo" href={url()}>Pun Times<br />with <em>Ph</em>riends<small>{site.tagline}</small></a>
      <nav class="nav">
        {nav.map(([href, label]) => <a href={url(href)} class={active === label ? 'on' : ''}>{label}</a>)}
      </nav>
      <div class="cast">
        {cast.map((p) => (
          <a class="chip" href={url(`cast/${p.id}/`)}><i style={`background:var(--c-${p.id})`}></i>{p.name}</a>
        ))}
      </div>
    </aside>
    <main class="main"><slot /></main>
  </div>
</body>
</html>

<style is:global>
:root{
  --ground:#EBEFE8; --paper:#FFFFFF; --paper-2:#F5F7F3; --ink:#1B221F; --muted:#5B6862; --line:#D3DAD1;
  --accent:#2F4BFF; --unknown:#E2E6E0; --unknown-ink:#1B221F;
  --display:"Bricolage Grotesque",ui-rounded,system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --hand:"Gochi Hand","Comic Sans MS","Chalkboard SE",cursive;
}
@media (prefers-color-scheme:dark){
  :root{color-scheme:dark;--ground:#121614;--paper:#1B211E;--paper-2:#171C1A;--ink:#E7EDE9;--muted:#9AA7A0;--line:#2D3632;--accent:#8C9DFF;--unknown:#2D3632;--unknown-ink:#E7EDE9}
}
*{box-sizing:border-box}
html{background:var(--paper-2)}
body{margin:0;background:var(--paper-2);color:var(--ink);font-family:var(--display);font-size:16px;line-height:1.55}
a{color:var(--accent)}
h1,h2,h3{text-wrap:balance;margin:0;line-height:1.1}
img{max-width:100%}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.shell{display:grid;grid-template-columns:240px 1fr;min-height:100vh;background:linear-gradient(to right,var(--paper) 239px,var(--line) 239px 240px,transparent 240px)}
.side{position:sticky;top:0;align-self:start;height:100vh;padding:32px 24px;display:flex;flex-direction:column;gap:26px}
.logo{font-weight:800;font-size:26px;line-height:.95;letter-spacing:-.03em;color:var(--ink);text-decoration:none}
.logo em{color:var(--accent)}
.logo small{display:block;font-family:var(--mono);font-weight:400;font-size:11px;letter-spacing:0;color:var(--muted);margin-top:10px}
.nav{display:flex;flex-direction:column;gap:2px}
.nav a{color:var(--muted);text-decoration:none;padding:3px 0}
.nav a.on,.nav a:hover{color:var(--ink);font-weight:700}
.cast{display:flex;flex-direction:column;gap:8px}
.chip{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--ink);text-decoration:none}
.chip i{width:14px;height:14px;border-radius:50% 50% 50% 3px;display:block;flex:none}
.main{padding:36px clamp(16px,5vw,56px) 80px;min-width:0}
.page-head{max-width:600px;margin-bottom:28px}
.page-head h1{font-size:clamp(30px,5vw,44px);font-weight:800;letter-spacing:-.03em}
.page-head p{color:var(--muted);margin:8px 0 0}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.feed{display:flex;flex-direction:column;gap:24px;max-width:600px}
.pager{display:flex;justify-content:space-between;max-width:600px;margin-top:32px;font-family:var(--mono);font-size:13px}
@media (max-width:820px){
  .shell{grid-template-columns:1fr;background:none}
  .side{position:static;height:auto;background:var(--paper);border-bottom:1px solid var(--line);flex-direction:row;flex-wrap:wrap;align-items:center;gap:14px 24px;padding:20px 16px}
  .nav{flex-direction:row;gap:14px}
  .cast{flex-direction:row;flex-wrap:wrap;gap:8px 14px}
}
</style>
